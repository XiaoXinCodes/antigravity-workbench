{
  "name": "antigravity-account-manager",
  "displayName": "Antigravity Workbench",
  "description": "Manage Google Antigravity accounts and generate images in one VS Code workbench.",
  "version": "0.1.8",
  "publisher": "xiaoxincodes",
  "icon": "media/icon.png",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/XiaoXinCodes/antigravity-workbench.git"
  },
  "homepage": "https://github.com/XiaoXinCodes/antigravity-workbench#readme",
  "bugs": {
    "url": "https://github.com/XiaoXinCodes/antigravity-workbench/issues"
  },
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=20"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onView:antigravityAccounts.accounts",
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "antigravityAccounts",
          "title": "Antigravity Workbench",
          "icon": "media/workbench.svg"
        }
      ]
    },
    "views": {
      "antigravityAccounts": [
        {
          "id": "antigravityAccounts.accounts",
          "name": "%view.workbench%",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "antigravityAccounts.debug.catalog",
        "title": "%command.debug.catalog%",
        "category": "Antigravity Workbench",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "antigravityAccounts.live.login",
        "title": "%command.live.login%",
        "category": "Antigravity Workbench",
        "icon": "$(add)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "antigravityAccounts.addAccount",
        "title": "%command.addAccount%",
        "category": "Antigravity Workbench",
        "icon": "$(add)"
      },
      {
        "command": "antigravityAccounts.removeAccount",
        "title": "%command.removeAccount%",
        "category": "Antigravity Workbench"
      },
      {
        "command": "antigravityAccounts.importSnapshot",
        "title": "%command.importSnapshot%",
        "category": "Antigravity Workbench",
        "icon": "$(cloud-download)"
      },
      {
        "command": "antigravityAccounts.refresh",
        "title": "%command.refresh%",
        "category": "Antigravity Workbench",
        "icon": "$(refresh)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "antigravityAccounts.openBridgeGuide",
        "title": "%command.openBridgeGuide%",
        "category": "Antigravity Workbench",
        "icon": "$(book)"
      },
      {
        "command": "antigravityAccounts.showCapabilities",
        "title": "%command.showCapabilities%",
        "category": "Antigravity Workbench"
      },
      {
        "command": "antigravityAccounts.reloadSnapshots",
        "title": "%command.reloadSnapshots%",
        "category": "Antigravity Workbench"
      },
      {
        "command": "antigravityAccounts.live.capture",
        "title": "%command.live.capture%",
        "category": "Antigravity Workbench",
        "icon": "$(key)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "antigravityAccounts.live.switch",
        "title": "%command.live.switch%",
        "category": "Antigravity Workbench",
        "icon": "$(arrow-swap)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "antigravityAccounts.live.verify",
        "title": "%command.live.verify%",
        "category": "Antigravity Workbench",
        "icon": "$(verified)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "antigravityAccounts.live.quota",
        "title": "%command.live.quota%",
        "category": "Antigravity Workbench",
        "icon": "$(graph)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "antigravityAccounts.live.quotaCancel",
        "title": "%command.live.quotaCancel%",
        "category": "Antigravity Workbench",
        "icon": "$(debug-stop)"
      },
      {
        "command": "antigravityAccounts.live.restore",
        "title": "%command.live.restore%",
        "category": "Antigravity Workbench",
        "icon": "$(history)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "antigravityAccounts.live.remove",
        "title": "%command.live.remove%",
        "category": "Antigravity Workbench",
        "icon": "$(trash)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "antigravityAccounts.live.unlock",
        "title": "%command.live.unlock%",
        "category": "Antigravity Workbench",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "antigravityAccounts.images.open",
        "title": "%command.images.open%",
        "category": "Antigravity Workbench",
        "icon": "$(file-media)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "antigravityAccounts.images.diagnoseAccount",
        "title": "%command.images.diagnoseAccount%",
        "category": "Antigravity Workbench"
      },
      {
        "command": "antigravityAccounts.images.diagnoseProject",
        "title": "%command.images.diagnoseProject%",
        "category": "Antigravity Workbench"
      },
      {
        "command": "antigravityAccounts.images.cancel",
        "title": "%command.images.cancel%",
        "category": "Antigravity Workbench",
        "icon": "$(debug-stop)"
      },
      {
        "command": "antigravityAccounts.openHelp",
        "title": "%command.openHelp%",
        "category": "Antigravity Workbench"
      },
      {
        "command": "antigravityAccounts.recheck",
        "title": "%command.recheck%",
        "category": "Antigravity Workbench"
      },
      {
        "command": "antigravityAccounts.openOfficialExtension",
        "title": "%command.openOfficialExtension%",
        "category": "Antigravity Workbench"
      },
      {
        "command": "antigravityAccounts.openWorkbenchExtension",
        "title": "%command.openWorkbenchExtension%",
        "category": "Antigravity Workbench"
      },
      {
        "command": "antigravityAccounts.openHostSettings",
        "title": "%command.openHostSettings%",
        "category": "Antigravity Workbench"
      },
      {
        "command": "antigravityAccounts.live.export",
        "title": "%command.live.export%",
        "category": "Antigravity Workbench",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "antigravityAccounts.live.import",
        "title": "%command.live.import%",
        "category": "Antigravity Workbench",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "antigravityAccounts.live.acceptance",
        "title": "%command.live.acceptance%",
        "category": "Antigravity Workbench"
      },
      {
        "command": "antigravityAccounts.debug.toggle",
        "title": "%command.debug.toggle%",
        "category": "Antigravity Workbench"
      },
      {
        "command": "antigravityAccounts.debug.copyDirectory",
        "title": "%command.debug.copyDirectory%",
        "category": "Antigravity Workbench"
      },
      {
        "command": "antigravityAccounts.debug.openDirectory",
        "title": "%command.debug.openDirectory%",
        "category": "Antigravity Workbench"
      },
      {
        "command": "antigravityAccounts.debug.preview",
        "title": "%command.debug.preview%",
        "category": "Antigravity Workbench"
      },
      {
        "command": "antigravityAccounts.debug.exportPreview",
        "title": "%command.debug.exportPreview%",
        "category": "Antigravity Workbench",
        "icon": "$(save-as)"
      },
      {
        "command": "antigravityAccounts.debug.tools",
        "title": "%command.debug.tools%",
        "category": "Antigravity Workbench"
      },
      {
        "command": "antigravityAccounts.debug.dismissCatalog",
        "title": "%command.debug.dismissCatalog%",
        "category": "Antigravity Workbench"
      },
      {
        "command": "antigravityAccounts.openSettings",
        "title": "%command.openSettings%",
        "category": "Antigravity Workbench"
      },
      {
        "command": "antigravityAccounts.quota.quickPick",
        "title": "%command.quota.quickPick%",
        "category": "Antigravity Workbench"
      },
      {
        "command": "antigravityAccounts.quota.refreshAll",
        "title": "%command.quota.refreshAll%",
        "category": "Antigravity Workbench"
      },
      {
        "command": "antigravityAccounts.quota.cancel",
        "title": "%command.quota.cancel%",
        "category": "Antigravity Workbench"
      },
      {
        "command": "antigravityAccounts.quota.unpin",
        "title": "%command.quota.unpin%",
        "category": "Antigravity Workbench"
      },
      {
        "command": "antigravityAccounts.quota.favorite",
        "title": "%command.quota.favorite%",
        "category": "Antigravity Workbench"
      },
      {
        "command": "antigravityAccounts.quota.pin",
        "title": "%command.quota.pin%",
        "category": "Antigravity Workbench"
      },
      {
        "command": "antigravityAccounts.automation.open",
        "title": "%command.automation.open%",
        "category": "Antigravity Workbench"
      },
      {
        "command": "antigravityAccounts.privacy.toggle",
        "title": "%command.privacy.toggle%",
        "category": "Antigravity Workbench"
      },
      {
        "command": "antigravityAccounts.quota.history",
        "title": "%command.quota.history%",
        "category": "Antigravity Workbench"
      }
    ],
    "menus": {
      "view/title": [],
      "view/item/context": [
        {
          "command": "antigravityAccounts.removeAccount",
          "when": "view == antigravityAccounts.accounts && viewItem == account",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "antigravityAccounts.addAccount",
          "when": "false"
        },
        {
          "command": "antigravityAccounts.removeAccount",
          "when": "false"
        },
        {
          "command": "antigravityAccounts.importSnapshot",
          "when": "false"
        },
        {
          "command": "antigravityAccounts.reloadSnapshots",
          "when": "false"
        },
        {
          "command": "antigravityAccounts.refresh",
          "when": "false"
        },
        {
          "command": "antigravityAccounts.openBridgeGuide",
          "when": "false"
        },
        {
          "command": "antigravityAccounts.showCapabilities",
          "when": "false"
        },
        {
          "command": "antigravityAccounts.live.unlock",
          "when": "false"
        },
        {
          "command": "antigravityAccounts.debug.catalog",
          "when": "false"
        },
        {
          "command": "antigravityAccounts.debug.toggle",
          "when": "false"
        },
        {
          "command": "antigravityAccounts.debug.copyDirectory",
          "when": "false"
        },
        {
          "command": "antigravityAccounts.debug.openDirectory",
          "when": "false"
        },
        {
          "command": "antigravityAccounts.debug.preview",
          "when": "false"
        },
        {
          "command": "antigravityAccounts.debug.exportPreview",
          "when": "false"
        },
        {
          "command": "antigravityAccounts.images.diagnoseAccount",
          "when": "false"
        },
        {
          "command": "antigravityAccounts.images.diagnoseProject",
          "when": "false"
        },
        {
          "command": "antigravityAccounts.openHostSettings",
          "when": "false"
        },
        {
          "command": "antigravityAccounts.openWorkbenchExtension",
          "when": "false"
        },
        {
          "command": "antigravityAccounts.locations.copyExtension",
          "when": "false"
        },
        {
          "command": "antigravityAccounts.locations.copyCredentials",
          "when": "false"
        },
        {
          "command": "antigravityAccounts.locations.copyImageOutput",
          "when": "false"
        },
        {
          "command": "antigravityAccounts.locations.openExtension",
          "when": "false"
        },
        {
          "command": "antigravityAccounts.live.acceptance",
          "when": "false"
        },
        {
          "command": "antigravityAccounts.debug.dismissCatalog",
          "when": "false"
        },
        {
          "command": "antigravityAccounts.quota.favorite",
          "when": "false"
        },
        {
          "command": "antigravityAccounts.quota.pin",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "antigravityAccounts.debug.exportPreview",
          "when": "resourceScheme == antigravity-debug-preview",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "Antigravity Workbench",
      "properties": {
        "antigravityAccounts.language": {
          "type": "string",
          "enum": [
            "zh-CN",
            "en"
          ],
          "enumItemLabels": [
            "简体中文",
            "English"
          ],
          "default": "zh-CN",
          "scope": "application",
          "description": "%setting.language.description%"
        },
        "antigravityAccounts.images.endpoint": {
          "type": "string",
          "enum": [
            "production",
            "daily"
          ],
          "enumDescriptions": [
            "%setting.endpoint.option.0%",
            "%setting.endpoint.option.1%"
          ],
          "default": "daily",
          "scope": "application",
          "description": "%setting.endpoint.description%"
        },
        "antigravityAccounts.hideIdentity": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "%configuration.hideIdentity%"
        }
      }
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('out', {recursive:true,force:true})\"",
    "compile": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "lint": "eslint src test scripts",
    "test": "npm run compile && node --test test/core.test.cjs test/files-bridge.test.cjs test/quota-query.test.cjs test/quota-ui.test.cjs test/switch-transaction.test.cjs test/live-switch.test.cjs test/live-environment.test.cjs test/native-host.test.cjs test/account-identity-interaction.test.cjs test/account-removal-backend.test.cjs test/backend-operation-ui.test.cjs test/live-ui.test.cjs test/live-hub-quota.test.cjs test/direct-login.test.cjs test/image-files.test.cjs test/image-service.test.cjs test/image-ui.test.cjs test/direct-image.test.cjs test/direct-image-protocol.test.cjs test/direct-image-response.test.cjs test/image-error-evidence.test.cjs test/image-error-message.test.cjs test/direct-image-acceptance.test.cjs test/recent-image-failure.test.cjs test/workbench-view.test.cjs test/workbench-locations.test.cjs test/account-migration.test.cjs test/account-export.test.cjs test/account-import.test.cjs test/account-import-verified.test.cjs test/migration-ui.test.cjs test/live-lock.test.cjs test/account-quota.test.cjs test/account-quota-transport.test.cjs test/acceptance-report.test.cjs test/account-refresh-store.test.cjs test/account-quota-refresh.test.cjs test/account-quota-client.test.cjs test/debug-events.test.cjs test/debug-log-store.test.cjs test/debug-ui.test.cjs test/official-restart.test.cjs test/bounded-official-stop.test.cjs test/official-process.test.cjs test/official-process-recovery.test.cjs test/official-process-helper.test.cjs test/image-operation-record.test.cjs test/direct-image-state.test.cjs test/direct-image-operation.test.cjs test/recovery-verification.test.cjs test/recovery-store.test.cjs test/saved-image-account.test.cjs test/image-catalog-diagnostic.test.cjs test/saved-image-models.test.cjs test/image-account-selection.test.cjs test/saved-image-integration.test.cjs test/image-session-store.test.cjs test/image-session-ui.test.cjs test/image-iteration.test.cjs test/image-iteration-ui.test.cjs test/image-project-actions.test.cjs test/image-session-compatibility.test.cjs test/image-quota.test.cjs test/i18n.test.cjs test/quota-presentation.test.cjs test/quota-batch.test.cjs test/quota-preferences.test.cjs test/automation-core.test.cjs test/quota-history-core.test.cjs test/advanced-wake.test.cjs test/passive-identity.test.cjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "vscode:prepublish": "npm run clean && npm run compile",
    "package": "node -e \"require('node:fs').mkdirSync('artifacts',{recursive:true})\" && vsce package --no-dependencies --no-rewrite-relative-links --out artifacts/antigravity-workbench-0.1.8.vsix && python scripts/prepare-vsix.py artifacts/antigravity-workbench-0.1.8.vsix",
    "test:host": "npm run compile && node scripts/test-host.cjs",
    "acceptance:offline": "npm run compile && node test/direct-image-acceptance.test.cjs && node test/direct-image.test.cjs",
    "test:quota-host": "npm run compile && node scripts/test-quota-host.cjs",
    "test:automation-host": "npm run compile && node scripts/test-automation-host.cjs",
    "test:history-host": "npm run compile && node scripts/test-history-host.cjs",
    "test:advanced-host": "npm run compile && node scripts/test-advanced-host.cjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^22.19.0",
    "@types/vscode": "1.95.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.7.1",
    "eslint": "^9.39.2",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0"
  }
}
